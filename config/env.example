# Создать .env: make env.

# Приложение
SERVICE_NAME=ozon-comments
STORAGE=inmemory

# Логирование
LOG_LEVEL=info

# HTTP-сервер
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

# GraphQL
GRAPHQL_COMPLEXITY_LIMIT=1000
MAX_PAGE_SIZE=100

# Подписки на комментарии
SUBSCRIPTION_BUFFER=64
WS_PING_INTERVAL=20s

# Аутентификация
# Случайный секрет создаётся командой make env.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=ozon-comments
AUTH_TOKEN_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_PASSWORD_COST=10
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_REQUEST_RATE=2
AUTH_REQUEST_BURST=5

# Подключение к PostgreSQL
# Настройки основной БД.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ozon
POSTGRES_PASSWORD=ozon
POSTGRES_DB=ozon
POSTGRES_SSLMODE=disable
# DATABASE_URL можно указать вместо отдельных настроек.
DATABASE_URL=
# Таймаут подключения к БД.
STARTUP_TIMEOUT=30s

# Миграции
MIGRATIONS_PATH=./migrations
MIGRATION_TIMEOUT=30s
MIGRATION_STATEMENT_TIMEOUT=15s
MIGRATION_LOCK_TIMEOUT=15s

# Порты приложения в Docker
APP_PORT=8080
# Порт внутри контейнера, как в HTTP_ADDR.
APP_CONTAINER_PORT=8080

# Тестовая PostgreSQL
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=55432
TEST_POSTGRES_USER=ozon_test
TEST_POSTGRES_PASSWORD=ozon_test_local
TEST_POSTGRES_DB=ozon_test
TEST_POSTGRES_SSLMODE=disable
# TEST_DATABASE_URL можно указать вместо TEST_POSTGRES_*.
TEST_DATABASE_URL=

# Метрики, Prometheus и Grafana
# make monitoring включает метрики автоматически.
METRICS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Случайный пароль создаётся командой make env.
GRAFANA_ADMIN_PASSWORD=
